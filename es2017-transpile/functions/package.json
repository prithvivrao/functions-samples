{
  "name": "es2017-functions",
  "description": "Sample app showing how to transpile ES7 code in cloud Functions.",
  "dependencies": {
    "babel-runtime": "^6.23.0",
    "firebase-admin": "^5.4.3",
    "firebase-functions": "^3.6.2",
    "@snyk/protect": "latest"
  },
  "devDependencies": {
    "babel-cli": "^6.24.1",
    "babel-plugin-transform-runtime": "^6.23.0",
    "babel-preset-latest": "^6.24.1"
  },
  "scripts": {
    "prepare": "npm run snyk-protect && babel ./*.es7 --presets latest --retain-lines -d ./",
    "snyk-protect": "snyk-protect"
  },
  "snyk": true
}
